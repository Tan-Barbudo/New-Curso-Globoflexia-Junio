rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return hasUserProfile() && currentUser().status == 'approved';
    }

    function isAdmin() {
      return isApproved() && currentUser().role == 'admin';
    }

    function isValidCategory(category) {
      return category in ['Duda', 'Logro', 'Inspiración', 'General'];
    }

    function isValidForumPost(data) {
      return data.keys().hasAll([
          'authorUid', 'authorName', 'authorAvatar', 'authorRole', 'content',
          'category', 'likedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'authorUid', 'authorName', 'authorAvatar', 'authorRole', 'content',
          'category', 'likedBy', 'createdAt', 'updatedAt'
        ])
        && data.authorUid == request.auth.uid
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 150
        && data.authorAvatar is string
        && data.authorAvatar.size() <= 1000
        && data.authorRole in ['Alumno', 'Admin']
        && (data.authorRole != 'Admin' || isAdmin())
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 5000
        && isValidCategory(data.category)
        && data.likedBy is list
        && data.likedBy.size() == 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidReply(data) {
      return data.keys().hasAll([
          'authorUid', 'authorName', 'authorAvatar', 'authorRole', 'content', 'createdAt'
        ])
        && data.keys().hasOnly([
          'authorUid', 'authorName', 'authorAvatar', 'authorRole', 'content', 'createdAt'
        ])
        && data.authorUid == request.auth.uid
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 150
        && data.authorAvatar is string
        && data.authorAvatar.size() <= 1000
        && data.authorRole in ['Alumno', 'Admin']
        && (data.authorRole != 'Admin' || isAdmin())
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 3000
        && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'photoURL', 'status', 'role', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'status', 'role', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 150
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'student'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }

    match /forum/{commentId} {
      allow read: if isApproved();
      allow create: if isApproved() && isValidForumPost(request.resource.data);

      allow update: if isAdmin()
        || (isApproved()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'updatedAt'])
          && request.resource.data.likedBy is list
          && request.resource.data.likedBy.size() <= 500
          && request.resource.data.updatedAt == request.time);

      allow delete: if isAdmin()
        || (isApproved() && resource.data.authorUid == request.auth.uid);

      match /replies/{replyId} {
        allow read: if isApproved();
        allow create: if isApproved() && isValidReply(request.resource.data);
        allow update, delete: if isAdmin()
          || (isApproved() && resource.data.authorUid == request.auth.uid);
      }
    }

    match /progress/{userId} {
      allow read, create, update, delete: if isApproved()
        && (request.auth.uid == userId || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
